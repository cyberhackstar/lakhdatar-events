# Safe staging template only; actual staging deployment secrets belong in protected CI secrets.
APP_ENV=staging
IMAGE_NAMESPACE=ghcr.io/your-github-owner
IMAGE_TAG=REPLACE_WITH_FULL_GIT_SHA
APP_VERSION=2.0.51
PUBLIC_HOST=staging-events.neelastack.com
PUBLIC_BASE_URL=https://staging-events.neelastack.com
NEELASTACK_PUBLIC_URL=https://neelastack.com
CORS_ALLOWED_ORIGINS=https://staging-events.neelastack.com
NG_ALLOWED_HOSTS=staging-events.neelastack.com
DEFAULT_PAYMENT_PROVIDER=CASHFREE
DB_URL=jdbc:postgresql://postgres:5432/lakhdatar
DB_USERNAME=lakhdatar
DB_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
REDIS_SSL=false
JWT_SECRET=
TICKET_VIEW_SECRET=
QR_SIGNING_SECRET=
MFA_ENCRYPTION_KEY=
JWT_ISSUER=neelastack-events
JWT_AUDIENCE=neelastack-events-web
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_API_VERSION=2025-01-01
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_TOLERANCE_MS=300000
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM="Neelastack Events <tickets@yourdomain.com>"
MAIL_STARTTLS=true
MAIL_DELIVERY_SWEEP=30000
MAIL_DELIVERY_CLEANUP_SWEEP=21600000
MAIL_DELIVERY_REPAIR_SWEEP=30000
RATE_LIMIT_FAIL_CLOSED=true
MAX_TICKETS_PER_ORDER=20
INITIAL_ADMIN_SETUP_ENABLED=false
INITIAL_ADMIN_SETUP_TOKEN=
BOOTSTRAP_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
