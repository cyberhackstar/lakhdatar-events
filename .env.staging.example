# Disposable isolated staging environment for enterprise E2E/load/DAST qualification.
# Never point this at the production database, Redis, or payment credentials.
IMAGE_NAMESPACE=ghcr.io/your-github-owner
IMAGE_TAG=<full-40-character-release-sha>
APP_VERSION=2.0.26
APP_ENV=staging

# Internal staging database lives in the staging Compose PostgreSQL service.
DB_URL=jdbc:postgresql://postgres:5432/lakhdatar_staging
DB_USERNAME=lakhdatar
DB_PASSWORD=<random-staging-db-password>

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=<random-32-byte-staging-redis-password>
REDIS_SSL=false

# Staging application secrets: random, unique, and never reused from production.
JWT_SECRET=<random-32-plus-byte-secret>
TICKET_VIEW_SECRET=<random-32-plus-byte-secret>
QR_SIGNING_SECRET=<random-32-plus-byte-secret>
MFA_ENCRYPTION_KEY=<base64-or-64-hex-encoded-32-byte-secret>
MFA_REQUIRED_FOR_PRIVILEGED=true
MFA_ISSUER=Neelastack Events Staging
AUTH_COOKIE_SECURE=true

JWT_ACCESS_TOKEN=15m
JWT_REFRESH_TOKEN=14d
JWT_ISSUER=neelastack-events-staging
JWT_AUDIENCE=neelastack-events-staging-web

PUBLIC_HOST=staging-events.neelastack.com
PUBLIC_BASE_URL=https://staging-events.neelastack.com
CORS_ALLOWED_ORIGINS=https://staging-events.neelastack.com
NEELASTACK_PUBLIC_URL=https://neelastack.com
NG_ALLOWED_HOSTS=staging-events.neelastack.com
NG_TRUST_PROXY_HEADERS=X-FORWARDED-FOR,X-FORWARDED-HOST,X-FORWARDED-PROTO

# Run production-like limits and workers in staging so load/E2E exercises the real controls.
WORKER_ENABLED=true
RATE_LIMIT_FAIL_CLOSED=true
DEFAULT_PAYMENT_PROVIDER=CASHFREE

# Provider sandbox/test credentials only. Keep production credentials out of this file.
CASHFREE_BASE_URL=<provider-sandbox-base-url>
CASHFREE_APP_ID=<staging-sandbox-app-id>
CASHFREE_SECRET_KEY=<staging-sandbox-secret>
CASHFREE_API_VERSION=2025-01-01

# Optional Razorpay sandbox/test credentials if that provider is selected.
RAZORPAY_BASE_URL=<provider-sandbox-base-url>
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email is optional for basic E2E; use a sink/test mailbox provider when ticket-email testing is enabled.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM="Neelastack Events Staging <staging-tickets@yourdomain.com>"
MAIL_STARTTLS=true

# Cloudinary is optional; use a staging folder/account if media E2E is enabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=neelastack-events-staging

# Bootstrap is OFF by default. For first staging provisioning, temporarily enable it with dedicated credentials.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=staging-admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=<random-12-plus-character-password>
BOOTSTRAP_ADMIN_NAME=Staging Administrator
BOOTSTRAP_ORGANIZER_NAME=Neelastack Events Staging
BOOTSTRAP_ORGANIZER_SLUG=neelastack-events-staging
BOOTSTRAP_EVENT_SLUG=enterprise-e2e-2026

# Do not set these to production.
PRODUCTION_TOPOLOGY=staging
