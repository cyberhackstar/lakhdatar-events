# Grafana is bound to loopback only; use an SSH tunnel or private VPN.
GRAFANA_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Postgres exporter should use a dedicated monitoring role with pg_monitor rather than the app owner.
PG_EXPORTER_USER=lakhdatar_monitor
PG_EXPORTER_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Redis exporter credentials (same Redis ACL/password as the production Redis instance).
REDIS_USER=default
REDIS_PASSWORD=REPLACE_WITH_PRODUCTION_REDIS_PASSWORD

PROMETHEUS_RETENTION=30d
