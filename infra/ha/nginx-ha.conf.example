# Enterprise HA edge reference.
# Deploy one copy of this edge on each application VM. Cloudflare Load Balancing / Tunnel pool
# health-checks /edge-health and sends traffic only to healthy VMs.
resolver 127.0.0.11 valid=5s ipv6=off;

map $http_cf_connecting_ip $client_rate_key {
    default $remote_addr;
    "~^[0-9A-Fa-f:.]{3,45}$" $http_cf_connecting_ip;
}
map $http_x_forwarded_proto $public_proto { default $scheme; https https; http http; }
map $host $monitor_root_redirect { default 0; monitor.neelastack.com 1; }
map $host $is_monitor_host { default 0; monitor.neelastack.com 1; }
map $http_x_correlation_id $edge_correlation_id {
    "~^[A-Za-z0-9._-]{8,80}$" $http_x_correlation_id;
    default $request_id;
}
limit_req_zone $client_rate_key zone=public_api:10m rate=20r/s;
limit_req_zone $client_rate_key zone=public_catalog_api:10m rate=1200r/s;
limit_req_zone $client_rate_key zone=auth_api:10m rate=5r/s;
limit_req_zone $client_rate_key zone=ops_logs_api:10m rate=2r/s;
limit_conn_zone $client_rate_key zone=per_ip:10m;

upstream backend_pool {
    zone backend_pool 64k;
    server backend:8080 resolve;
    keepalive 64;
}
upstream web_pool {
    zone web_pool 64k;
    server web:3000 resolve;
    keepalive 32;
}

proxy_cache_path /var/cache/nginx/public-cache levels=1:2 keys_zone=public_catalog:20m max_size=24m inactive=60s use_temp_path=off;
proxy_cache_key "$scheme$request_method$host$request_uri";
proxy_cache_lock on;
proxy_cache_background_update on;

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_vary on;
gzip_proxied any;
gzip_types application/json application/javascript application/xml text/plain text/css text/javascript image/svg+xml;

log_format edge_json escape=json '{"time":"$time_iso8601","request_id":"$request_id","status":$status,"method":"$request_method","uri":"$uri","remote_ip":"$client_rate_key","request_time":$request_time,"upstream_time":"$upstream_response_time","host":"$host","correlation_id":"$edge_correlation_id"}';

server {
    listen 8080;
    server_name _;
    access_log /dev/stdout edge_json;
    error_log /dev/stderr warn;
    server_tokens off;
    # Preserve relative Location headers so Cloudflare/Tunnel never leaks the private origin port.
    absolute_redirect off;
    client_max_body_size 6m;
    limit_conn per_ip 1000;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Permissions-Policy 'camera=(self), microphone=(), geolocation=(), payment=(self "https://api.cashfree.com" "https://payments.cashfree.com" "https://checkout.razorpay.com")' always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://checkout.razorpay.com https://sdk.cashfree.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://api.razorpay.com https://checkout.razorpay.com https://lumberjack.razorpay.com https://api.cashfree.com https://sdk.cashfree.com; frame-src 'self' https://api.razorpay.com https://checkout.razorpay.com https://sdk.cashfree.com https://payments.cashfree.com https://api.cashfree.com; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://api.cashfree.com https://payments.cashfree.com;" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_rate_key;
    proxy_set_header X-Forwarded-For $client_rate_key;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $public_proto;
    proxy_set_header CF-Connecting-IP $client_rate_key;
    proxy_set_header X-Correlation-ID $edge_correlation_id;
    proxy_connect_timeout 5s;

    location = /edge-health { access_log off; default_type text/plain; return 200 "ok\n"; }

    location = / {
        if ($monitor_root_redirect) { return 302 /monitor$is_args$args; }
        proxy_pass http://web_pool;
        proxy_read_timeout 20s;
    }


    # Dedicated SRE console. The same private edge serves both hostnames, but the monitor
    # route is only exposed when the Host header is monitor.neelastack.com.
    location = /monitor {
        if ($is_monitor_host = 0) { return 404; }
        proxy_pass http://web_pool;
        proxy_read_timeout 20s;
    }
    location = /monitor/ {
        if ($is_monitor_host = 0) { return 404; }
        return 308 /monitor;
    }

    # Keep business admin pages on the Events hostname. The monitor hostname exposes only the SRE console
    # plus the authenticated API paths it needs.
    location ^~ /admin {
        if ($is_monitor_host = 1) { return 404; }
        proxy_pass http://web_pool;
        proxy_read_timeout 20s;
    }

    location = /login {
        proxy_pass http://web_pool;
        proxy_read_timeout 20s;
    }

    location = /change-password {
        proxy_pass http://web_pool;
        proxy_read_timeout 20s;
    }

    location ^~ /api/v1/public/events/ {
        if ($is_monitor_host = 1) { return 404; }
        limit_req zone=public_catalog_api burst=2000 nodelay;
        proxy_pass http://backend_pool;
        proxy_read_timeout 20s;
        proxy_send_timeout 10s;
        proxy_buffering on;
        proxy_buffers 8 16k;
        proxy_buffer_size 16k;
        proxy_cache public_catalog;
        proxy_cache_methods GET HEAD;
        proxy_cache_valid 200 5s;
        proxy_cache_valid 404 2s;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_bypass $http_authorization $cookie_lk_refresh $cookie_ld_checkout;
        proxy_no_cache $http_authorization $cookie_lk_refresh $cookie_ld_checkout;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    # Private-only NGINX metrics endpoint for the internal nginx-prometheus-exporter.
    location = /stub_status {
        access_log off;
        stub_status;
        allow 172.16.0.0/12;
        allow 127.0.0.1;
        deny all;
    }

    location ^~ /api/v1/auth/ {
        limit_req zone=auth_api burst=10 nodelay;
        proxy_pass http://backend_pool;
        proxy_send_timeout 15s;
        proxy_read_timeout 30s;
        proxy_buffering off;
    }
    # Buffer admin event responses at the origin edge. This includes streamed CSV exports,
    # preventing the generic unbuffered /api/ proxy from exposing an unstable transfer to the edge.
    location ^~ /api/v1/admin/events/ {
        if ($is_monitor_host = 1) { return 404; }
        limit_req zone=public_api burst=40 nodelay;
        proxy_pass http://backend_pool;
        proxy_send_timeout 30s;
        proxy_read_timeout 60s;
        proxy_buffering on;
        proxy_buffers 8 16k;
        proxy_buffer_size 16k;
    }

    location = /api/v1/admin/ops/logs {
        limit_req zone=ops_logs_api burst=4 nodelay;
        proxy_pass http://backend_pool;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
        proxy_buffering on;
        proxy_buffers 4 16k;
        proxy_buffer_size 16k;
    }

    location ^~ /api/v1/admin/ops/ {
        proxy_pass http://backend_pool;
        proxy_send_timeout 15s;
        proxy_read_timeout 30s;
        proxy_buffering off;
    }

    location ^~ /api/ {
        if ($is_monitor_host = 1) { return 404; }
        limit_req zone=public_api burst=40 nodelay;
        proxy_pass http://backend_pool;
        proxy_send_timeout 15s;
        proxy_read_timeout 30s;
        proxy_buffering off;
    }
    location = /robots.txt { if ($is_monitor_host = 1) { return 404; } proxy_pass http://backend_pool; proxy_read_timeout 10s; }
    location = /sitemap.xml { if ($is_monitor_host = 1) { return 404; } proxy_pass http://backend_pool; proxy_read_timeout 10s; }
    location ~ ^/sitemap-[0-9]+\.xml$ { if ($is_monitor_host = 1) { return 404; } proxy_pass http://backend_pool; proxy_read_timeout 10s; }

    location ^~ /ticket/ {
        if ($is_monitor_host = 1) { return 404; }
        access_log off;
        proxy_pass http://web_pool;
        proxy_read_timeout 20s;
    }
    location / {
        if ($is_monitor_host = 1) { return 404; }
        proxy_pass http://web_pool;
        proxy_read_timeout 20s;
    }
}
