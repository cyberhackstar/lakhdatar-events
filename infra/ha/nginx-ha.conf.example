# Enterprise HA edge reference.
# Deploy one copy of this edge on each application VM. Cloudflare Load Balancing / Tunnel pool
# health-checks /edge-health and sends traffic only to healthy VMs.
resolver 127.0.0.11 valid=5s ipv6=off;

map $http_cf_connecting_ip $client_rate_key {
    default $remote_addr;
    "~^[0-9A-Fa-f:.]{3,45}$" $http_cf_connecting_ip;
}
map $http_x_forwarded_proto $public_proto { default $scheme; https https; http http; }
limit_req_zone $client_rate_key zone=public_api:10m rate=20r/s;
limit_req_zone $client_rate_key zone=auth_api:10m rate=5r/s;
limit_conn_zone $client_rate_key zone=per_ip:10m;

upstream backend_pool {
    zone backend_pool 64k;
    server backend:8080 resolve;
}
upstream web_pool {
    zone web_pool 64k;
    server web:3000 resolve;
}

log_format edge_json escape=json '{"time":"$time_iso8601","request_id":"$request_id","status":$status,"method":"$request_method","uri":"$uri","remote_ip":"$client_rate_key","request_time":$request_time,"upstream_time":"$upstream_response_time","host":"$host"}';

server {
    listen 8080;
    server_name _;
    access_log /dev/stdout edge_json;
    error_log /dev/stderr warn;
    server_tokens off;
    client_max_body_size 6m;
    limit_conn per_ip 40;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Permissions-Policy 'camera=(self), microphone=(), geolocation=(), payment=(self "https://api.cashfree.com" "https://payments.cashfree.com" "https://checkout.razorpay.com")' always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://checkout.razorpay.com https://sdk.cashfree.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://api.razorpay.com https://checkout.razorpay.com https://lumberjack.razorpay.com https://api.cashfree.com https://sdk.cashfree.com; frame-src 'self' https://api.razorpay.com https://checkout.razorpay.com https://sdk.cashfree.com https://payments.cashfree.com https://api.cashfree.com; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self' https://api.cashfree.com https://payments.cashfree.com;" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $client_rate_key;
    proxy_set_header X-Forwarded-For $client_rate_key;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $public_proto;
    proxy_set_header CF-Connecting-IP $client_rate_key;
    proxy_connect_timeout 5s;

    location = /edge-health { access_log off; default_type text/plain; return 200 "ok\n"; }

    location ^~ /api/v1/auth/ {
        limit_req zone=auth_api burst=10 nodelay;
        proxy_pass http://backend_pool;
        proxy_send_timeout 15s;
        proxy_read_timeout 30s;
        proxy_buffering off;
    }
    # Buffer admin event responses at the origin edge. This includes streamed CSV exports,
    # preventing the generic unbuffered /api/ proxy from exposing an unstable transfer to the edge.
    location ^~ /api/v1/admin/events/ {
        limit_req zone=public_api burst=40 nodelay;
        proxy_pass http://backend_pool;
        proxy_send_timeout 30s;
        proxy_read_timeout 60s;
        proxy_buffering on;
        proxy_buffers 8 16k;
        proxy_buffer_size 16k;
    }

    location ^~ /api/ {
        limit_req zone=public_api burst=40 nodelay;
        proxy_pass http://backend_pool;
        proxy_send_timeout 15s;
        proxy_read_timeout 30s;
        proxy_buffering off;
    }
    location = /robots.txt { proxy_pass http://backend_pool; proxy_read_timeout 10s; }
    location = /sitemap.xml { proxy_pass http://backend_pool; proxy_read_timeout 10s; }
    location ~ ^/sitemap-[0-9]+\.xml$ { proxy_pass http://backend_pool; proxy_read_timeout 10s; }

    location ^~ /ticket/ {
        access_log off;
        proxy_pass http://web_pool;
        proxy_read_timeout 20s;
    }
    location / {
        proxy_pass http://web_pool;
        proxy_read_timeout 20s;
    }
}
