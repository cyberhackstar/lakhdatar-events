# Reference template for a real two-VM HA deployment; all secret fields must be populated securely.
PRODUCTION_TOPOLOGY=enterprise-ha
HA_NODE_COUNT=2
HA_INGRESS_HEALTH_URL=https://events.neelastack.com/edge-health
HA_HEALTH_TIMEOUT_SECONDS=10
HA_HEALTH_RETRIES=2

# Public host set expected at the load balancer / ingress layer.
PUBLIC_HOSTS=events.neelastack.com,monitor.neelastack.com
PUBLIC_BASE_URL=https://events.neelastack.com
NEELASTACK_PUBLIC_URL=https://neelastack.com
CORS_ALLOWED_ORIGINS=https://events.neelastack.com

# Use managed services with TLS and failover; never set these to localhost.
DB_EXTERNAL_HOST=postgres.example.internal
DB_EXTERNAL_TLS=true
DB_URL=jdbc:postgresql://postgres.example.internal:5432/lakhdatar?sslmode=require
DB_USERNAME=lakhdatar
DB_PASSWORD=
REDIS_EXTERNAL_HOST=redis.example.internal
REDIS_EXTERNAL_TLS=true
REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=true
REDIS_DATABASE=0

IMAGE_NAMESPACE=ghcr.io/your-github-owner
IMAGE_TAG=REPLACE_WITH_FULL_GIT_SHA
APP_VERSION=2.0.54
JWT_SECRET=
JWT_ISSUER=neelastack-events
JWT_AUDIENCE=neelastack-events-web
TICKET_VIEW_SECRET=
QR_SIGNING_SECRET=
MFA_ENCRYPTION_KEY=
DEFAULT_PAYMENT_PROVIDER=CASHFREE
CASHFREE_BASE_URL=https://api.cashfree.com/pg
CASHFREE_API_VERSION=2025-01-01
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM="Neelastack Events <tickets@yourdomain.com>"
MFA_REQUIRED_FOR_PRIVILEGED=true
