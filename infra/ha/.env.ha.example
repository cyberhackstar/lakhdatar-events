IMAGE_NAMESPACE=ghcr.io/your-org
IMAGE_TAG=REPLACE_WITH_IMMUTABLE_SHA
APP_VERSION=2.0.35
NG_ALLOWED_HOSTS=events.neelastack.com,monitor.neelastack.com
NEELASTACK_PUBLIC_URL=https://neelastack.com
REDIS_SSL=true
WORKER_DB_POOL_MAX=8
WORKER_DB_POOL_MIN=2

# External high-availability dependencies. Keep secrets out of Git.
DB_URL=jdbc:postgresql://<managed-postgres-host>:5432/lakhdatar
DB_USERNAME=lakhdatar
DB_PASSWORD=<secret>
REDIS_HOST=<managed-redis-host>
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=<secret>

# Immutable application secrets shared by all application replicas.
JWT_SECRET=<32+ byte random secret>
TICKET_VIEW_SECRET=<32+ byte random secret>
QR_SIGNING_SECRET=<32+ byte random secret>
JWT_ACCESS_TOKEN=15m
JWT_REFRESH_TOKEN=14d
JWT_ISSUER=neelastack-events
JWT_AUDIENCE=neelastack-events-web

PUBLIC_BASE_URL=https://events.neelastack.com
CORS_ALLOWED_ORIGINS=https://events.neelastack.com

# Provider and mail secrets are injected identically on both application VMs.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM="Neelastack Events <events@neelastack.com>"
MAIL_STARTTLS=true


MFA_REQUIRED_FOR_PRIVILEGED=true
MFA_ENCRYPTION_KEY=<base64-or-64-hex-encoded-32-byte-secret>
MFA_ISSUER=Neelastack Events
PASSWORD_RESET_CLEANUP_SWEEP=21600000
MFA_CLEANUP_SWEEP=21600000

# This profile is the enterprise HA target; run one stack per failure-domain VM.
PRODUCTION_TOPOLOGY=enterprise-ha
