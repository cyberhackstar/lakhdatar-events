# Safe production dotenv template. Never commit your filled .env file.
# Copy this file to .env and fill every required secret with a unique random value.
# Generate secret values with: openssl rand -hex 32

# Immutable application images. IMAGE_TAG must be a full 40-character Git SHA.
IMAGE_NAMESPACE=ghcr.io/your-github-owner
IMAGE_TAG=REPLACE_WITH_FULL_GIT_SHA
APP_VERSION=2.0.44

# Public application URLs
PUBLIC_HOST=events.neelastack.com
PUBLIC_BASE_URL=https://events.neelastack.com
NEELASTACK_PUBLIC_URL=https://neelastack.com
CORS_ALLOWED_ORIGINS=https://events.neelastack.com
NG_ALLOWED_HOSTS=events.neelastack.com
NG_TRUST_PROXY_HEADERS=true
PRODUCTION_TOPOLOGY=single-node
# Keep false until a deliberate single-node production deployment is approved.
ALLOW_SINGLE_NODE_PRODUCTION=false

# Required persistence credentials: replace blank values before deployment.
DB_URL=jdbc:postgresql://postgres:5432/lakhdatar
DB_USERNAME=lakhdatar
DB_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
REDIS_SSL=false

# Generate unique random values; do not reuse them between environments.
JWT_SECRET=
TICKET_VIEW_SECRET=
QR_SIGNING_SECRET=
MFA_ENCRYPTION_KEY=
JWT_ISSUER=neelastack-events
JWT_AUDIENCE=neelastack-events-web
JWT_ACCESS_TOKEN=15m
JWT_REFRESH_TOKEN=14d
TICKET_VIEW_TTL=720h
QR_IMAGE_SIZE=512
AUTH_COOKIE_SECURE=true
MFA_REQUIRED_FOR_PRIVILEGED=true
MFA_ISSUER=Neelastack Events

# Payment provider configuration. Keep the unselected provider credentials empty.
DEFAULT_PAYMENT_PROVIDER=CASHFREE
CASHFREE_BASE_URL=https://api.cashfree.com/pg
CASHFREE_API_VERSION=2025-01-01
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_TOLERANCE_MS=300000
CASHFREE_CONNECT_TIMEOUT_MS=3000
CASHFREE_READ_TIMEOUT_MS=10000
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional media storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=neelastack-events
CLOUDINARY_MAX_BYTES=5242880

# SMTP is optional. MAIL_FROM must remain quoted because it contains spaces and angle brackets.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM="Neelastack Events <tickets@yourdomain.com>"
MAIL_STARTTLS=true
MAIL_DELIVERY_SWEEP=30000
MAIL_DELIVERY_CLEANUP_SWEEP=21600000
MAIL_DELIVERY_REPAIR_SWEEP=30000

# Capacity, reservation, retry and concurrency controls.
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_CONNECTION_TIMEOUT_MS=5000
DB_VALIDATION_TIMEOUT_MS=2000
DB_MAX_LIFETIME_MS=1800000
SERVER_TOMCAT_MAX_THREADS=200
SERVER_TOMCAT_MIN_SPARE_THREADS=20
SERVER_TOMCAT_MAX_CONNECTIONS=10000
SERVER_TOMCAT_ACCEPT_COUNT=1000
SERVER_TOMCAT_CONNECTION_TIMEOUT=5s
SERVER_TOMCAT_KEEP_ALIVE_TIMEOUT=30s
SERVER_TOMCAT_MAX_KEEP_ALIVE_REQUESTS=100
RESERVATION_HOLD=12m
RESERVATION_SWEEP=15s
RESERVATION_SWEEP_BATCH_SIZE=500
RESERVATION_SWEEP_MAX_BATCHES=8
MAX_TICKETS_PER_ORDER=20
CHECKOUT_SESSION_TTL=20m
RATE_LIMIT_FAIL_CLOSED=true
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_PER_WINDOW=10
CHECKOUT_RATE_LIMIT_PER_WINDOW=20
CHECKIN_RATE_LIMIT_PER_MINUTE=240
PAYMENT_ORDER_RECOVERY_SWEEP=30000
PAYMENT_RECONCILIATION_AGE_MS=120000
PAYMENT_RECONCILIATION_SWEEP=30000
REFUND_RECOVERY_SWEEP=30000
REFUND_CANCELLATION_SWEEP=30000
REFUND_MAX_ATTEMPTS=8
REFUND_CANCELLATION_BATCH_SIZE=500
REFUND_RECOVERY_BATCH_SIZE=500
REFUND_RETRY_BASE_DELAY=30s
REFUND_RETRY_MAX_DELAY=6h
REFUND_PROCESSING_TIMEOUT=24h
WEBHOOK_MAX_ATTEMPTS=12
WEBHOOK_RETRY_BASE_DELAY=2s
WEBHOOK_RETRY_MAX_DELAY=15m
WEBHOOK_RECOVERY_SWEEP=15000
WEBHOOK_RETENTION_DAYS=365
WEBHOOK_RETENTION_BATCH_SIZE=500
WEBHOOK_RETENTION_SWEEP=21600000
REFRESH_TOKEN_CLEANUP_SWEEP=3600000
PASSWORD_RESET_CLEANUP_SWEEP=21600000
MFA_CLEANUP_SWEEP=21600000
MANAGEMENT_SERVER_PORT=8081

# Initial setup is disabled unless explicitly enabled for a controlled bootstrap.
INITIAL_ADMIN_SETUP_ENABLED=false
INITIAL_ADMIN_SETUP_TOKEN=
BOOTSTRAP_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Observability defaults; configure external endpoints only when deployed.
OTEL_SERVICE_NAME=lakhdatar-events-backend
OTEL_RESOURCE_ATTRIBUTES=service.version=2.0.44,deployment.environment=production
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SDK_ENABLED=true
OTEL_METRICS_EXPORT_ENABLED=false
TRACING_SAMPLING_PROBABILITY=0.10
OPS_LOGS_ENABLED=true
LOKI_URL=
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SERVICE=INFO
