# Production secret values must be random, private and stored outside Git.
DB_PASSWORD=
JWT_SECRET=
JWT_ACCESS_TOKEN=15m
JWT_REFRESH_TOKEN=14d
AUTH_COOKIE_SECURE=true
TICKET_VIEW_TTL=24h
REFRESH_TOKEN_CLEANUP_SWEEP=3600000

# --- Runtime tuning (keep explicitly versioned; production incidents should not depend on hidden defaults) ---
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_CONNECTION_TIMEOUT_MS=5000
DB_VALIDATION_TIMEOUT_MS=2000
DB_MAX_LIFETIME_MS=1800000
RESERVATION_HOLD=12m
RESERVATION_SWEEP=30s
PAYMENT_ORDER_RECOVERY_SWEEP=30000
REFUND_RECOVERY_SWEEP=30000
REFUND_CANCELLATION_SWEEP=30000
REFUND_MAX_ATTEMPTS=8
REFUND_RETRY_BASE_DELAY=30s
REFUND_RETRY_MAX_DELAY=6h
REFUND_PROCESSING_TIMEOUT=24h
WEBHOOK_MAX_ATTEMPTS=12
WEBHOOK_RETRY_BASE_DELAY=2s
WEBHOOK_RETRY_MAX_DELAY=15m
WEBHOOK_RECOVERY_SWEEP=15000
WEBHOOK_RETENTION_DAYS=365
WEBHOOK_RETENTION_BATCH_SIZE=500
WEBHOOK_RETENTION_SWEEP=21600000
QR_IMAGE_SIZE=512
LOGIN_RATE_LIMIT_PER_WINDOW=10
CHECKOUT_RATE_LIMIT_PER_WINDOW=20
CHECKIN_RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_CLOSED=true
MAX_TICKETS_PER_ORDER=20
CHECKOUT_SESSION_TTL=20m
MAIL_DELIVERY_SWEEP=30000
MAIL_DELIVERY_CLEANUP_SWEEP=21600000
MAIL_DELIVERY_REPAIR_SWEEP=30000
TICKET_VIEW_SECRET=
QR_SIGNING_SECRET=
DEFAULT_PAYMENT_PROVIDER=CASHFREE
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_BASE_URL=https://api.cashfree.com/pg
CASHFREE_API_VERSION=2025-01-01
CASHFREE_RECONCILIATION_AGE_MS=120000
CASHFREE_RECONCILIATION_SWEEP=30000
CASHFREE_CONNECT_TIMEOUT_MS=3000
CASHFREE_READ_TIMEOUT_MS=8000
CASHFREE_WEBHOOK_TOLERANCE_MS=300000
PAYMENT_RECONCILIATION_AGE_MS=120000
PAYMENT_RECONCILIATION_SWEEP=30000

# One-time production admin provisioning. Keep disabled until the deployment is ready.
INITIAL_ADMIN_SETUP_ENABLED=false
INITIAL_ADMIN_SETUP_TOKEN=

# Cloudinary stores organizer logos and event images. Required for logo uploads (create/replace organizer logo, event banner/cover).
# Without it the platform still works; uploads simply return 'Cloudinary media storage is not configured'.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=neelastack-events
CLOUDINARY_MAX_BYTES=5242880

# GHCR image namespace, e.g. ghcr.io/your-github-owner
IMAGE_NAMESPACE=ghcr.io/your-github-owner
IMAGE_TAG=<git-sha-of-release>

NEELASTACK_PUBLIC_URL=https://neelastack.com
CORS_ALLOWED_ORIGINS=https://events.neelastack.com
PUBLIC_BASE_URL=https://events.neelastack.com
PUBLIC_HOST=events.neelastack.com
# Angular SSR host/proxy contract. Production should keep these exact values unless the public hostname changes.
NG_ALLOWED_HOSTS=events.neelastack.com,monitor.neelastack.com
NG_TRUST_PROXY_HEADERS=X-FORWARDED-FOR,X-FORWARDED-HOST,X-FORWARDED-PROTO

BOOTSTRAP_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
CHECKIN_EARLY_WINDOW=30m

# Optional off-host backup destination. In production this should be mounted/connected storage independent of the Oracle VM.
BACKUP_DIR=/home/ubuntu/apps/lakhdatar-events/infra/backups
SECONDARY_BACKUP_DIR=
BACKUP_RETENTION_DAYS=14
BACKUP_REMOTE_REQUIRED=true
BACKUP_REMOTE_URI=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_SSE=AES256
BACKUP_S3_KMS_KEY_ID=

# Organizer name + logo are NOT environment settings: an admin enters them (Cloudinary upload) in the Organizers page.
# The Neelastack logo is the file frontend/src/assets/neelastack-logo.png - replace the file, not an env var.

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=
TICKET_VIEW_SECRET_PREVIOUS=
QR_SIGNING_SECRET_PREVIOUS=

# --- Email (ticket delivery + team invites) -------------------------------------------------
# Leave MAIL_HOST empty to keep email OFF: tickets still work on the ticket page and /recover,
# complimentary tickets show "email not configured", and team members are created with a password.
# Gmail:  MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_USERNAME=you@gmail.com
#         MAIL_PASSWORD=<16-char Google App Password (needs 2-Step Verification)>  (about 500 mails/day limit)
# Production: use a transactional SMTP provider (Amazon SES, Brevo, Resend, Mailgun) and a sender on your own domain.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM="Neelastack Events <tickets@yourdomain.com>"
MAIL_STARTTLS=true

# Privileged MFA
MFA_REQUIRED_FOR_PRIVILEGED=true
MFA_ENCRYPTION_KEY=
MFA_ISSUER=Neelastack Events
PASSWORD_RESET_CLEANUP_SWEEP=21600000
MFA_CLEANUP_SWEEP=21600000

# Deployment safety: the single-VM deploy script is never considered HA. Set true only when you explicitly accept that failure domain.
PRODUCTION_TOPOLOGY=single-node
ALLOW_SINGLE_NODE_PRODUCTION=false
SMOKE_TICKET_ID=
SMOKE_TICKET_TOKEN=
SMOKE_TICKET_PDF=false
SMOKE_ENTERPRISE=false # Set true for certified production; requires a dedicated issued ticket/token.
